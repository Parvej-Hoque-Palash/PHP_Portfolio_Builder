# Copy to .env.local (gitignored) and fill in the values. For deployments, put the same
# public values in src/config/siteConfig.ts instead (see README.md); these override it.
# Credentials: https://console.cloud.google.com/apis/credentials

# OAuth 2.0 Web Client ID (dashboard sign-in)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Whose portfolio is shown at "/" — set ONE of these (Gmail only).
# Usernames are "php-" + the Gmail prefix with dots turned into "-":
#   janedoe@gmail.com -> php-janedoe  (served at "/" and "/php-janedoe")
#   (a dotted address like jane.doe@gmail.com -> php-jane-doe)
# That account also starts from the built-in content in src/data/defaultPortfolio.ts;
# every other Gmail account gets its own blank portfolio at /php-<prefix>.
# VITE_DEFAULT_USERNAME keeps your email address out of the public JS bundle.
VITE_DEFAULT_USERNAME=
# VITE_OWNER_EMAIL=janedoe@gmail.com

# Browser API key used by visitors (not signed in) to read published portfolio files.
# REQUIRED for public links (/portfolio?id=…) and /php-<username> pages: without it the
# site shows "Google API Key is not configured" instead of the portfolio.
# Restrict it to the Google Drive API and your site's HTTP referrers, and set it in
# Netlify too (Site configuration -> Environment variables) — see README.md.
VITE_GOOGLE_API_KEY=your-api-key

# Optional fallback for the default portfolio's config file ID. Prefer listing it in
# public/portfolios.json, which maps every username to its file ID:
#   { "php-janedoe": "1AbC...", "php-john-smith": "1XyZ..." }
VITE_PORTFOLIO_CONFIG_FILE_ID=
