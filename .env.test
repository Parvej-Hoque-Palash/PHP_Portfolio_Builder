# Fake values for the end-to-end tests (`npm run test:e2e`). Google and Drive are
# simulated by e2e/fakeGoogle.ts, so nothing here is a real credential.
VITE_GOOGLE_CLIENT_ID=e2e-client.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=e2e-api-key
VITE_DEFAULT_USERNAME=php-owner-demo
VITE_OWNER_EMAIL=owner.demo@gmail.com
VITE_PORTFOLIO_CONFIG_FILE_ID=
